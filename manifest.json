{
  "manifest_version": 3,
  "name": "Reminder Extension",
  "version": "2.0",
  "description": "Manage reminders with desktop notifications. Built with design patterns and SOLID principles.",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reminder Extension"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
